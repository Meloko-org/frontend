# dependencies
node_modules/

# Expo
.expo/
./expo-share
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*
/.metro-cache

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
yarn.lock 

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

