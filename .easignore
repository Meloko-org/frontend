*.log
*.tmp

# Ignore build artifacts
/android/app/build
/ios/build
/build

# Ignore Git
/.git
/.gitignore

# Ignore Tests
/__tests__/

# Ignore large asset folders (adjust if needed)
/assets/raw/*
/assets/videos/*